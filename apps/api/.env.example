# Server
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fb_autoreply?schema=public"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Facebook / Meta
FB_APP_ID=
FB_APP_SECRET=
FB_API_VERSION=v21.0
FB_VERIFY_TOKEN=change-me-to-any-random-string
FB_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# OpenAI (optional for AI fallback)
OPENAI_API_KEY=

# Encryption for at-rest secrets (Page Access Tokens, etc).
# Generate with: openssl rand -hex 32
# REQUIRED in production. In development a fallback dev key is used if unset.
TOKEN_ENCRYPTION_KEY=

# Rate limiting (per IP, per minute) — auth endpoints are stricter than the rest.
AUTH_RATE_LIMIT_PER_MIN=10
API_RATE_LIMIT_PER_MIN=300

# Per-tenant outbound reply throttle. Defaults to 30 replies in a burst,
# refilling at 0.5/sec (i.e. 30/minute steady-state). Tune to your Meta limits.
OUTBOUND_RATE_BURST=30
OUTBOUND_RATE_PER_SECOND=0.5

# Logging
LOG_LEVEL=info

# Email notifications. Leave SMTP_HOST empty to disable email delivery (the
# scheduler will still tick — it just logs what it *would* have sent).
# For Postmark: SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587
# For SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<your-key>
# For Gmail (testing only): SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true with an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=fb-autoreply <noreply@example.com>

# Single-instance scheduler safety. If you ever scale to >1 API instance,
# set this to false on every instance EXCEPT one — otherwise users will get
# duplicate alert/digest emails.
NOTIFICATIONS_SCHEDULER_ENABLED=true
